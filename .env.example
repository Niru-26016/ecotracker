# EcoTracker Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# n8n Workflow Integration (Required for AI chat)
VITE_N8N_WEBHOOK_URL=your-n8n-webhook-url

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id
VITE_ADSENSE_ID=your-adsense-id

# Payment Integration (Optional)
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# AI API Keys (Optional - used by n8n workflow)
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_GEMINI_API_KEY=your-gemini-api-key
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
# VITE_PERPLEXITY_API_KEY=your-perplexity-api-key
